# Upstash Redis (server-side only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AES-256-GCM key: base64 encoding of exactly 32 random bytes.
# Generate with: openssl rand -base64 32
# Keep stable and private; changing it makes stored panel credentials unreadable.
PANEL_CREDENTIALS_ENCRYPTION_KEY=

# Public canonical URL, used for origin checks and links.
APP_URL=http://localhost:3000
