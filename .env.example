# Upstash Redis (server-side only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Encryption key: generate 32 random bytes and base64 encode them.
# Never store this key in Redis or commit its real value.
PANEL_CREDENTIALS_ENCRYPTION_KEY=

# Session signing secret; use a long random value.
SESSION_SECRET=

# Public canonical URL, used for origin checks and links.
APP_URL=http://localhost:3000